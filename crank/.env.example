# SHIFT crank configuration. Env only (FR-4.4). NEVER commit a real .env, never paste a secret into a chat or a log (NFR-S5).
RPC_URL=https://api.mainnet-beta.solana.com

# Identity. DRY-RUN needs ONLY the public key (no secret on the machine at all):
EXECUTOR_PUBKEY=
# LIVE only (base58 or JSON byte array). Leave empty in dry-run.
EXECUTOR_KEYPAIR=

# Safety: dry-run is the default. LIVE needs BOTH of these, and only after the owner says "go live":
DRY_RUN=1
# ACKNOWLEDGE_LIVE=I-ACCEPT-MAINNET-TRANSACTIONS

PRIORITY_FEE_MICROLAMPORTS=1000   # capped at 2,000,000
PORT=8080
POLL_MS=2000
END_MARGIN_SLOTS=8
MAX_ITEMS_PER_TX=5
